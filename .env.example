# Copy to .env.development for local dev, .env.production for prod builds.
# Shared vars go in .env (loaded in all modes).

VITE_APP_ENVIRONMENT=development

VITE_APP_URL=your_app_url_here

VITE_SENTRY_DSN=https://your_dsn@ingest.de.sentry.io/your_project_id
SENTRY_PROJECT=your_sentry_project_here

VITE_AUTH_REDIRECT_URL=your_auth_redirect_url_here

VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_URL=your_supabase_url_here

VITE_HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=your_helius_api_key_here

# --- .env (shared) ---
SENTRY_ORG=your_sentry_org_here
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# Server-side mainnet RPC used by /api/solana/rpc (defaults to publicnode). VITE_SOLANA_RPC_URL overrides it in dev.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# Server-side DFlow API key for /api/dflow/order. Optional: without it the public dev host is used (60 req/min).
DFLOW_API_KEY=your_dflow_api_key_here

# --- Supabase Edge Function secrets (set with `supabase secrets set`, NOT in .env) ---
# Telegram limit-order alerts. See docs/TELEGRAM_ALERTS.md
# SESSION_SECRET=              # openssl rand -hex 32
# TELEGRAM_BOT_TOKEN=          # from @BotFather
# TELEGRAM_BOT_USERNAME=       # without @
# TELEGRAM_WEBHOOK_SECRET=     # openssl rand -hex 32
# CRON_SECRET=                 # openssl rand -hex 32
# APP_URL=https://your-domain.com
# ALLOWED_ORIGIN=https://your-domain.com
