# Copy to .env.development for local dev, .env.production for prod builds.
# Shared vars go in .env (loaded in all modes).

VITE_APP_ENVIRONMENT=development

VITE_APP_URL=your_app_url_here

VITE_SENTRY_DSN=https://your_dsn@ingest.de.sentry.io/your_project_id
SENTRY_PROJECT=your_sentry_project_here

VITE_AUTH_REDIRECT_URL=your_auth_redirect_url_here

VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_URL=your_supabase_url_here

VITE_HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=your_helius_api_key_here

# --- .env (shared) ---
SENTRY_ORG=your_sentry_org_here
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
VITE_EITHERWAY_HOST_URL=your_eitherway_host_url_here
VITE_EITHERWAY_APP_ID=your_eitherway_app_id_here
